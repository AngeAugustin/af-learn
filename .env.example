# Copiez ce fichier en .env.local puis renseignez vos propres valeurs.
# Chaîne de connexion à votre base PostgreSQL locale :
# postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/NOM_DE_LA_BASE
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/cursus

# URL publique du site, utilisée dans les liens envoyés par email (obligatoire en production)
APP_URL=http://localhost:3000
# Adresse qui reçoit les messages du formulaire de contact et s'affiche sur les pages légales
CONTACT_EMAIL=
# Envoi des emails (réinitialisation, contact) via Resend. Sans ces valeurs, en développement,
# les emails sont affichés dans la console du serveur.
RESEND_API_KEY=
MAIL_FROM="Cursus <no-reply@votre-domaine.fr>"
# Ou, à la place de MAIL_FROM, l'adresse et le nom séparément :
# RESEND_FROM_EMAIL=no-reply@votre-domaine.fr
# SMTP_FROM_NAME="Cursus"
